-- PUBLIC API
----------------------------------------------------------------------
local function makeHandle(e)
    local h = {}
    function h:Get()
        if e.type == "multi" then
            local out = {}
            for i, opt in ipairs(e.options) do if e.sel[i] then out[#out + 1] = opt end end
            return out
        end
        return e.val
    end
    function h:Set(v) e.val = v end
    function h:SetText(s) e.text = s end
    function h:Options(items) e.options = items or {}; e.val = 1 end
    return h
end

function Library:Window(opts)
    opts = opts or {}
    local m = ensureManager()
    local win = {
        title  = opts.title or "Window",
        client = opts.client ~= nil and opts.client or "",
        x = opts.x or 24, y = opts.y or 24,
        width = opts.width or 230,
        open = (opts.open ~= false),
        elems = {},
    }
    m.windows[#m.windows + 1] = win

    local W = {}
    local function push(e) win.elems[#win.elems + 1] = e; return makeHandle(e) end

    function W:Section(text) return push({ type = "section", text = text or "SECTION" }) end
    function W:Label(o) o = o or {}; return push({ type = "label", text = o.text or "", get = o.get }) end
    function W:Button(o)
        o = o or {}
        return push({ type = "button", text = o.text or "Button", cb = o.callback or function() end })
    end
    function W:Toggle(o)
        o = o or {}
        return push({ type = "toggle", text = o.text or "Toggle", val = o.default and true or false,
                      cb = o.callback or function() end })
    end
    function W:Slider(o)
        o = o or {}
        local mn, mxv = o.min or 0, o.max or 100
        return push({ type = "slider", text = o.text or "Slider", min = mn, max = mxv,
                      val = math.clamp(o.default or mn, mn, mxv), dec = o.decimals or 0,
                      cb = o.callback or function() end })
    end
    function W:Dropdown(o)
        o = o or {}
        return push({ type = "dropdown", text = o.text or "Dropdown", options = o.options or {},
                      val = o.default or 1, cb = o.callback or function() end })
    end
    function W:MultiDropdown(o)
        o = o or {}
        local options = o.options or {}
        local sel = {}
        if o.default then
            for _, d in ipairs(o.default) do
                if type(d) == "number" then sel[d] = true
                else for i, opt in ipairs(options) do if opt == d then sel[i] = true end end end
            end
        end
        return push({ type = "multi", text = o.text or "Dropdown", options = options,
                      sel = sel, cb = o.callback or function() end })
    end
    function W:Keybind(o)
        o = o or {}
        return push({ type = "keybind", text = o.text or "Keybind", val = o.default or "None",
                      cb = o.callback or function() end, _was = false, bindMenu = o.bindMenu })
    end
    function W:Box(o)
        o = o or {}
        return push({ type = "box", text = o.text or "Box", val = o.default or "",
                      placeholder = o.placeholder or "...", cb = o.callback or function() end })
    end
    function W:Info(o)
        o = o or {}
        return push({ type = "info", lines = o.lines, get = o.get })
    end

    function W:SetVisible(v) win.open = v and true or false end
    function W:Remove()
        for i, w in ipairs(m.windows) do if w == win then table.remove(m.windows, i); break end end
    end
    return W
end

-- alias
Library.CreateWindow = Library.Window

-- Built-in Config window: pinned far-right, holds the menu toggle keybind and
-- credits. Returns its builder so more can be added later via Library:Config().
ensureConfig = function()
    local m = ensureManager()
    if m.config then return m.configW end
    local W = Library:Window({ title = "Config", client = "", x = 24, y = 24, width = 200 })
    local win = m.windows[#m.windows]
    win._config = true
    m.config, m.configW = win, W
    W:Section("MENU")
    W:Keybind({ text = "Toggle Menu", bindMenu = true })
    W:Section("CREDITS")
    W:Label({ text = "Troll" })
    return W
end

function Library:Config() return ensureConfig() end

function Library:SetToggleKey(key)
    local m = ensureManager()
    if typeof(key) == "EnumItem" then m.menuKey = key
    else local kc = strToVk(key); if kc then m.menuKey = kc end end
end
function Library:SetVisible(v) ensureManager().visible = v and true or false end
function Library:Toggle() local m = ensureManager(); m.visible = not m.visible end
function Library:SetMouseOffset(x, y) local m = ensureManager(); m.offX = x or 0; m.offY = y or 0 end
function Library:Notify(title, body, dur)
    local m = ensureManager()
    dur = dur or 3
    m.notifs[#m.notifs + 1] = { title = title or "Notice", body = (body ~= "" and body) or nil,
                                expire = os.clock() + dur, dur = dur }
end

return Library
