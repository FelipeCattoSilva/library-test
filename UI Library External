--[[
    Jael Library — floating multi-window ClickGUI for RbxCLI
    =============================================================================
    Standalone, dependency-free UI library built on RbxCLI's IMMEDIATE-mode
    drawing API. Each :Window() is its own draggable, minimizable floating panel
    (magenta theme). Click a window to bring it to front. One global key hides /
    shows everything.

    -------------------------------------------------------------------------
    LOADING  (RbxCLI — no game:HttpGet; needs the runtime-loadstring grant)
    -------------------------------------------------------------------------
      --!grant RuntimeLoadstring
      local Library = rbxcli.loadstring(game:GetService("HttpService"):RequestAsync({
          Method = "GET",
          Url = "https://raw.githubusercontent.com/<user>/<repo>/refs/heads/main/<file>"
      }).Body)()

    -------------------------------------------------------------------------
    USAGE
    -------------------------------------------------------------------------
      Library:SetToggleKey(Enum.KeyCode.RightAlt)   -- hide / show all windows

      local w = Library:Window({ title="Iron Soul", client="Client", x=24, y=24, width=230 })
      w:Section ("AUTO FARM")
      w:Toggle  ({ text="Auto Farm (H)", default=false, callback=function(v) end })
      w:Dropdown({ text="Farm Position", options={"Behind","Above","Below"}, default=1,
                   callback=function(i,item) end })
      w:Slider  ({ text="Stand Dist", min=2, max=20, default=16, decimals=0,
                   callback=function(v) end })
      w:Keybind ({ text="Toggle Farm", default="H", callback=function() end })
      w:Box     ({ text="Name", placeholder="...", callback=function(s) end })
      w:Button  ({ text="Rejoin Server", callback=function() end })
      w:Info    ({ get=function() return { "area: World1", "enemies: 0" } end })
      w:Label   ({ text="static" })

      -- elements return a handle:  h:Get()  h:Set(v)  h:SetText(s)
      Library:Notify("Title","body",3)

    -------------------------------------------------------------------------
    HOW IT WORKS
    -------------------------------------------------------------------------
      RbxCLI exposes IMMEDIATE-mode drawing (NOT executor Drawing.new):
        immediate.rectangle(p1,p2,rounding,filled,outline,Color4)
        immediate.text(Vector2,text,fd,centered,Color4)
        immediate.line(p1,p2,thick,?,Color4)
        immediate.circle(center,r,filled,outline,Color4)
        immediate.calculate_text_size(text,fd) -> Vector2
      Drawings live ONE frame. The library redraws everything every PreRender and
      polls input in Heartbeat (edge-detecting clicks). Descriptor-driven:
      builders record element specs (val + callback); callbacks fire via task.spawn.
]]

local RunService       = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

----------------------------------------------------------------------
-- FONTS / MEASURE
----------------------------------------------------------------------
local FD   = font.get_font_descriptor("Arial", 13)
local FD_S = font.get_font_descriptor("Arial", 12)
local FD_T = font.get_font_descriptor("Arial", 13)

local function measure(t, fd)
    local ok, v = pcall(immediate.calculate_text_size, t, fd)
    if ok and v then return v.X, v.Y end
    return #t * 7, 12
end

----------------------------------------------------------------------
-- KEY MAPS (keybind capture/display + toggle key + box typing)
----------------------------------------------------------------------
local VK_NAMES = {
    [Enum.KeyCode.LeftButton]="M1", [Enum.KeyCode.RightButton]="M2",
    [Enum.KeyCode.MiddleButton]="M3", [Enum.KeyCode.LeftShift]="Shift",
    [Enum.KeyCode.LeftControl]="Ctrl", [Enum.KeyCode.LeftAlt]="Alt",
    [Enum.KeyCode.Space]="Space", [Enum.KeyCode.Tab]="Tab",
    [Enum.KeyCode.Return]="Enter", [Enum.KeyCode.Backspace]="Back",
}
do
    local okRA, ra = pcall(function() return Enum.KeyCode.RightAlt end)
    if okRA and ra then VK_NAMES[ra] = "RightAlt" end
    local okRC, rc = pcall(function() return Enum.KeyCode.RightControl end)
    if okRC and rc then VK_NAMES[rc] = "RightControl" end
    for i = 0, 25 do VK_NAMES[Enum.KeyCode[string.char(65 + i)]] = string.char(65 + i) end
    local dig = {"Zero","One","Two","Three","Four","Five","Six","Seven","Eight","Nine"}
    for i, n in ipairs(dig) do VK_NAMES[Enum.KeyCode[n]] = tostring(i - 1) end
    for _, f in ipairs({"F1","F2","F3","F4","F5","F6","F7","F8","F9","F10","F11","F12"}) do
        VK_NAMES[Enum.KeyCode[f]] = f
    end
end
local VK_BY_NAME, ALL_KC = {}, {}
for kc, nm in pairs(VK_NAMES) do VK_BY_NAME[nm:upper()] = kc; ALL_KC[#ALL_KC + 1] = kc end
local function vkToStr(kc) return kc and VK_NAMES[kc] or "None" end
local function strToVk(s) return s and VK_BY_NAME[tostring(s):upper()] or nil end
local function isMouseVk(kc)
    return kc == Enum.KeyCode.LeftButton or kc == Enum.KeyCode.RightButton or kc == Enum.KeyCode.MiddleButton
end
local function vkDown(kc)
    if not kc then return false end
    if isMouseVk(kc) then return UserInputService:IsMouseButtonPressed(kc) end
    return UserInputService:IsKeyDown(kc)
end

local SHIFT_DIGIT = {["1"]="!",["2"]="@",["3"]="#",["4"]="$",["5"]="%",["6"]="^",["7"]="&",["8"]="*",["9"]="(",["0"]=")"}
local PUNCT = {}
do
    local defs = { Minus={"-","_"}, Equals={"=","+"}, Period={".",">"}, Comma={",","<"},
                   Slash={"/","?"}, Semicolon={";",":"} }
    for name, pair in pairs(defs) do
        local ok, kc = pcall(function() return Enum.KeyCode[name] end)
        if ok and kc then PUNCT[kc] = pair end
    end
end
local function charFor(kc, shift)
    local nm = VK_NAMES[kc]
    if nm and #nm == 1 then
        if nm:match("%a") then return shift and nm:upper() or nm:lower() end
        if nm:match("%d") then return shift and SHIFT_DIGIT[nm] or nm end
    end
    local p = PUNCT[kc]; if p then return shift and p[2] or p[1] end
    return nil
end

local function pin(mx, my, x, y, w, h)
    return mx >= x and mx <= x + w and my >= y and my <= y + h
end

----------------------------------------------------------------------
-- THEME  (ports iron-soul-windows.tsx)
----------------------------------------------------------------------
local function c4(r, g, b, a) return Color4.new(r, g, b, a or 1) end
local C = {
    accent    = c4(0.808, 0.290, 0.769, 1),    -- rgb(206,74,196)
    accentSoft= c4(0.690, 0.486, 0.769, 1),    -- rgb(176,124,196)
    accentDim = c4(0.588, 0.282, 0.745, 0.32),  -- rgba(150,72,190,0.32)
    panel     = c4(0.063, 0.059, 0.075, 0.98),  -- rgb(16,15,19)
    stroke    = c4(0.157, 0.141, 0.180, 1),     -- rgb(40,36,46)
    rowHov    = c4(0.105, 0.098, 0.120, 1),
    input     = c4(0.102, 0.102, 0.125, 1),     -- rgb(26,26,32)
    track     = c4(0.149, 0.141, 0.173, 1),     -- rgb(38,36,44)
    cbOff     = c4(0.337, 0.329, 0.369, 1),     -- rgb(86,84,94)
    text      = c4(0.871, 0.871, 0.894, 1),     -- rgb(222,222,228)
    dim       = c4(0.463, 0.455, 0.494, 1),     -- rgb(118,116,126)
    black     = c4(0, 0, 0, 1),
}

----------------------------------------------------------------------
-- LIBRARY  (manager singleton + Window builder)
----------------------------------------------------------------------
local Library = {}

local PAD      = 12
local TITLE_H  = 26
local ROW_H    = 26
local SEC_H    = 22
local BTN_H    = 30
local SLIDER_H = 36

-- ── shared manager (created lazily on first Window) ─────────────────────
local M = nil
local ensureConfig   -- forward decl: builds the pinned built-in Config window

local function ensureManager()
    if M then return M end
    M = {
        windows  = {},      -- draw order; front = last
        visible  = true,
        menuKey  = strToVk("RightAlt") or Enum.KeyCode.RightAlt,
        menuWas  = false,
        offX     = 0, offY = -25,   -- GetMouseLocation vs immediate.* space: Y off by -25 in this build
        notifs   = {},
        -- input
        mx = 0, my = 0, lmb = false, lmbPrev = false,
        -- transient focus / popups (element refs)
        ddOpen = nil, kbListen = nil, boxFocus = nil,
        dragWin = nil, dragOX = 0, dragOY = 0,
        dragSlider = nil,
        pendingDD = nil,
    }

    -- ── primitives ──────────────────────────────────────────────────────
    local function fill(x, y, w, h, col, r)
        immediate.rectangle(Vector2.new(x, y), Vector2.new(x + w, y + h), r or 0, true, false, col)
    end
    local function stroke(x, y, w, h, col, r)
        immediate.rectangle(Vector2.new(x, y), Vector2.new(x + w, y + h), r or 0, false, true, col)
    end
    local function txt(x, y, t, col, fd)
        immediate.text(Vector2.new(x, y), t, fd or FD, false, col or C.text)
    end
    local function ctxt(cx, y, t, col, fd)
        local tw = measure(t, fd or FD)
        immediate.text(Vector2.new(cx - tw / 2, y), t, fd or FD, false, col or C.text)
    end
    M.fill, M.stroke, M.txt, M.ctxt = fill, stroke, txt, ctxt

    -- ── element metrics ─────────────────────────────────────────────────
    local function infoLines(e)
        local v = e.lines
        if e.get then local ok, r = pcall(e.get); if ok and r ~= nil then v = r end end
        if type(v) == "string" then v = { v } end
        return v or {}
    end
    local function elemH(e)
        if e.type == "section" then return SEC_H
        elseif e.type == "label"  then return 18
        elseif e.type == "button" then return BTN_H
        elseif e.type == "slider" then return SLIDER_H
        elseif e.type == "info"   then return 8 + (#infoLines(e) * 14 + 16) + 4
        else return ROW_H end
    end
    M.elemH = elemH

    -- window total height (title + underline + body)
    local function winHeight(win)
        if not win.open then return TITLE_H + 2 end
        local body = 6
        for _, e in ipairs(win.elems) do body = body + elemH(e) end
        return TITLE_H + 2 + body + 4
    end
    M.winHeight = winHeight

    -- ── draw one element. (x,y,w) span the window body column. ──────────
    -- selected items of a multi-dropdown (as option strings)
    local function multiSelected(e)
        local out = {}
        for i, opt in ipairs(e.options) do if e.sel[i] then out[#out + 1] = opt end end
        return out
    end
    local function multiLabel(e)
        local n = #multiSelected(e)
        if n == 0 then return "None"
        elseif n == #e.options and n > 0 then return "All"
        elseif n == 1 then return multiSelected(e)[1]
        else return n .. " selected" end
    end

    local function drawElement(e, x, y, w, allowClick)
        local mx, my = M.mx, M.my
        local h = elemH(e)

        -- accept a click only if allowed, hovered, and NOT under an open overlay
        local function acc(px, py, pw, ph)
            if not allowClick then return false end
            if not pin(mx, my, px, py, pw, ph) then return false end
            if M.blockRect and pin(mx, my, M.blockRect.x, M.blockRect.y, M.blockRect.w, M.blockRect.h) then
                return false
            end
            return true
        end

        if e.type == "section" then
            txt(x + PAD, y + h - 14, e.text, C.accent, FD_S)
            return y + h
        end

        if e.type == "label" then
            local s = e.text
            if e.get then local ok, v = pcall(e.get); if ok and v then s = v end end
            txt(x + PAD, y + 2, tostring(s or ""), C.dim, FD_S)
            return y + h
        end

        if e.type == "button" then
            local bx, by, bw, bh = x + PAD, y + 4, w - PAD * 2, BTN_H - 10
            local hov = pin(mx, my, bx, by, bw, bh)
            fill(bx, by, bw, bh, C.panel, 4)
            stroke(bx, by, bw, bh, hov and C.accent or C.stroke, 4)
            ctxt(x + w / 2, by + bh / 2 - 7, e.text, C.text, FD_S)
            if acc(bx, by, bw, bh) then task.spawn(e.cb) end
            return y + h
        end

        if e.type == "toggle" then
            local hov = pin(mx, my, x, y, w, h)
            if e.val then fill(x, y, w, h, C.accentDim, 0) end
            txt(x + PAD, y + h / 2 - 7, e.text, C.text, FD)
            local bs = 14
            local bx, by = x + w - PAD - bs, y + h / 2 - bs / 2
            if e.val then
                fill(bx - 1, by - 1, bs + 2, bs + 2, C.accentDim, 4)  -- faux glow
                fill(bx, by, bs, bs, C.accent, 3)
                stroke(bx, by, bs, bs, C.accent, 3)
            else
                stroke(bx, by, bs, bs, C.cbOff, 3)
            end
            if acc(x, y, w, h) then e.val = not e.val; task.spawn(e.cb, e.val) end
            return y + h
        end

        if e.type == "slider" then
            local vstr = (e.dec > 0) and string.format("%." .. e.dec .. "f", e.val)
                                      or tostring(math.floor(e.val + 0.5))
            txt(x + PAD, y + 3, e.text, C.text, FD)
            local vw = measure(vstr, FD_S)
            txt(x + w - PAD - vw, y + 4, vstr, C.accentSoft, FD_S)
            local tx, ty, tw, th = x + PAD, y + 22, w - PAD * 2, 6
            fill(tx, ty, tw, th, C.track, 3)
            local ratio = math.clamp((e.val - e.min) / (e.max - e.min), 0, 1)
            if ratio > 0 then fill(tx, ty, math.floor(tw * ratio), th, C.accent, 3) end
            if acc(tx, ty - 6, tw, th + 12) then M.dragSlider = e end
            if M.dragSlider == e and M.lmb then
                local r = math.clamp((mx - tx) / tw, 0, 1)
                local nv = e.min + r * (e.max - e.min)
                if e.dec == 0 then nv = math.floor(nv + 0.5)
                else local m = 10 ^ e.dec; nv = math.floor(nv * m + 0.5) / m end
                if nv ~= e.val then e.val = nv; task.spawn(e.cb, nv) end
            end
            return y + h
        end

        if e.type == "dropdown" then
            local hov = pin(mx, my, x, y, w, h)
            if hov then fill(x, y, w, h, C.rowHov, 0) end
            txt(x + PAD, y + h / 2 - 7, e.text, C.text, FD)
            local bw = 100
            local bx, by = x + w - PAD - bw, y + h / 2 - 9
            local isOpen = (M.ddOpen == e)
            fill(bx, by, bw, 18, C.input, 4)
            stroke(bx, by, bw, 18, isOpen and C.accent or C.stroke, 4)
            local cur = e.options[e.val] or "—"
            txt(bx + 7, by + 3, tostring(cur), C.text, FD_S)
            txt(bx + bw - 13, by + 3, isOpen and "^" or "v", C.text, FD_S)
            if acc(bx, by, bw, 18) then M.ddOpen = isOpen and nil or e end
            if isOpen then
                M.pendingDD = { e = e, x = bx, y = by + 19, w = bw }
                e._ovl = { x = bx, y = by + 19, w = bw, h = #e.options * 18 + 2 }
            end
            return y + h
        end

        if e.type == "multi" then
            local hov = pin(mx, my, x, y, w, h)
            if hov then fill(x, y, w, h, C.rowHov, 0) end
            txt(x + PAD, y + h / 2 - 7, e.text, C.text, FD)
            local bw = 100
            local bx, by = x + w - PAD - bw, y + h / 2 - 9
            local isOpen = (M.ddOpen == e)
            fill(bx, by, bw, 18, C.input, 4)
            stroke(bx, by, bw, 18, isOpen and C.accent or C.stroke, 4)
            txt(bx + 7, by + 3, multiLabel(e), C.text, FD_S)
            txt(bx + bw - 13, by + 3, isOpen and "^" or "v", C.text, FD_S)
            if acc(bx, by, bw, 18) then M.ddOpen = isOpen and nil or e end
            if isOpen then
                M.pendingDD = { e = e, x = bx, y = by + 19, w = bw }
                e._ovl = { x = bx, y = by + 19, w = bw, h = #e.options * 18 + 2 }
            end
            return y + h
        end

        if e.type == "keybind" then
            local hov = pin(mx, my, x, y, w, h)
            if hov then fill(x, y, w, h, C.rowHov, 0) end
            txt(x + PAD, y + h / 2 - 7, e.text, C.text, FD)
            local listen = (M.kbListen == e)
            local cur = e.bindMenu and vkToStr(M.menuKey) or tostring(e.val)
            local s = listen and "..." or ("[ " .. cur .. " ]")
            local bw = math.max(58, measure(s, FD_S) + 18)
            local bx, by = x + w - PAD - bw, y + h / 2 - 9
            fill(bx, by, bw, 18, C.input, 4)
            stroke(bx, by, bw, 18, listen and C.accent or C.stroke, 4)
            ctxt(bx + bw / 2, by + 3, s, listen and C.accent or C.text, FD_S)
            if acc(bx, by, bw, 18) then M.kbListen = listen and nil or e end
            return y + h
        end

        if e.type == "box" then
            local hov = pin(mx, my, x, y, w, h)
            if hov then fill(x, y, w, h, C.rowHov, 0) end
            txt(x + PAD, y + h / 2 - 7, e.text, C.text, FD)
            local bw = 88
            local bx, by = x + w - PAD - bw, y + h / 2 - 9
            local focused = (M.boxFocus == e)
            fill(bx, by, bw, 18, C.input, 4)
            stroke(bx, by, bw, 18, focused and C.accent or C.stroke, 4)
            local shown = (e.val ~= "" and e.val) or e.placeholder
            local tcol  = (e.val ~= "") and C.text or C.dim
            if focused then shown = e.val .. "|"; tcol = C.text end
            local sw = measure(shown, FD_S)
            txt(bx + bw - 6 - sw, by + 3, shown, tcol, FD_S)   -- right-aligned
            if acc(bx, by, bw, 18) then M.boxFocus = focused and nil or e end
            return y + h
        end

        if e.type == "info" then
            local lines = infoLines(e)
            local bx, by = x + PAD, y + 4
            local bw, bh = w - PAD * 2, #lines * 14 + 14
            fill(bx, by, bw, bh, C.accentDim, 5)
            stroke(bx, by, bw, bh, C.accent, 5)
            for i, ln in ipairs(lines) do
                local s, col = ln, C.dim
                if type(ln) == "table" then s = ln[1] or ln.text or ""; if ln.soft then col = C.accentSoft end end
                txt(bx + 8, by + 6 + (i - 1) * 14, tostring(s), col, FD_S)
            end
            return y + h
        end

        return y + h
    end
    M.drawElement = drawElement

    -- ── dropdown overlay (drawn on top of all windows) ──────────────────
    local function drawDropdown(dd, click)
        local mx, my = M.mx, M.my
        local e, x, y, w = dd.e, dd.x, dd.y, dd.w
        local rowH = 18
        local hgt = #e.options * rowH + 2
        fill(x, y, w, hgt, C.panel, 4)
        stroke(x, y, w, hgt, C.stroke, 4)

        if e.type == "multi" then
            for i, item in ipairs(e.options) do
                local iy  = y + 1 + (i - 1) * rowH
                local hov = pin(mx, my, x, iy, w, rowH)
                local on  = e.sel[i]
                if hov then fill(x + 1, iy, w - 2, rowH, C.rowHov, 0) end
                local bs, cbx, cby = 10, x + 7, iy + rowH / 2 - 5
                if on then fill(cbx, cby, bs, bs, C.accent, 2)
                else stroke(cbx, cby, bs, bs, C.cbOff, 2) end
                txt(cbx + bs + 6, iy + 3, tostring(item), on and C.text or C.dim, FD_S)
                if click and hov then
                    e.sel[i] = (not e.sel[i]) or nil      -- toggle, stays open
                    task.spawn(e.cb, multiSelected(e))
                end
            end
            if click and not pin(mx, my, x, y, w, hgt) then M.ddOpen = nil end
            return
        end

        for i, item in ipairs(e.options) do
            local iy  = y + 1 + (i - 1) * rowH
            local hov = pin(mx, my, x, iy, w, rowH)
            if e.val == i then fill(x + 1, iy, w - 2, rowH, C.accent, 0)
            elseif hov     then fill(x + 1, iy, w - 2, rowH, C.rowHov, 0) end
            txt(x + 7, iy + 3, tostring(item), e.val == i and C.black or C.text, FD_S)
            if click and hov then e.val = i; M.ddOpen = nil; task.spawn(e.cb, i, item) end
        end
        if click and not pin(mx, my, x, y, w, hgt) then M.ddOpen = nil end
    end

    -- ── notifications (top-right of screen) ─────────────────────────────
    local function drawNotifs()
        local now = os.clock()
        for i = #M.notifs, 1, -1 do if M.notifs[i].expire <= now then table.remove(M.notifs, i) end end
        local nx, ny = nil, 24
        local sw = 1280
        pcall(function() sw = workspace.CurrentCamera.ViewportSize.X end)
        nx = sw - 240
        for _, n in ipairs(M.notifs) do
            local hgt = n.body and 46 or 30
            fill(nx, ny, 220, hgt, C.panel, 5)
            stroke(nx, ny, 220, hgt, C.stroke, 5)
            fill(nx, ny, 3, hgt, C.accent, 0)
            txt(nx + 12, ny + 6, n.title, C.text, FD_S)
            if n.body then txt(nx + 12, ny + 22, n.body, C.dim, FD_S) end
            local pr = math.clamp((n.expire - now) / n.dur, 0, 1)
            fill(nx + 8, ny + hgt - 5, (220 - 16) * pr, 2, C.accent, 0)
            ny = ny + hgt + 8
        end
    end

    -- ── draw one window ─────────────────────────────────────────────────
    local function drawWindow(win, allowClick, click)
        local mx, my = M.mx, M.my
        local x, y, w = win.x, win.y, win.width
        local H = winHeight(win)
        win._w, win._h = w, H

        fill(x, y, w, H, C.panel, 6)

        -- title bar
        fill(x, y, w, TITLE_H, C.panel, 6)
        local tx = x + PAD
        txt(tx, y + TITLE_H / 2 - 7, win.title, C.text, FD_T)
        local titW = measure(win.title .. " ", FD_T)
        if win.client and win.client ~= "" then
            txt(tx + titW, y + TITLE_H / 2 - 7, win.client, C.accent, FD_T)
        end
        -- minimize / restore button
        do
            local bs = 16
            local bx, by = x + w - PAD - bs + 4, y + TITLE_H / 2 - bs / 2
            local hov = pin(mx, my, bx, by, bs, bs)
            ctxt(bx + bs / 2, by + bs / 2 - 8, win.open and "-" or "+", hov and C.text or C.dim, FD_T)
            if allowClick and hov then win.open = not win.open end
        end
        -- accent underline
        fill(x, y + TITLE_H, w, 2, C.accent, 0)

        -- body
        if win.open then
            local cy = y + TITLE_H + 2 + 4
            for _, e in ipairs(win.elems) do
                cy = drawElement(e, x, cy, w, allowClick)
            end
        end

        -- left accent edge + outer border
        fill(x, y, 2, H, C.accent, 0)
        stroke(x, y, w, H, C.stroke, 6)
    end

    -- ── input loop (Heartbeat) ──────────────────────────────────────────
    RunService.Heartbeat:Connect(function()
        local ml = UserInputService:GetMouseLocation()
        M.mx, M.my = ml.X + M.offX, ml.Y + M.offY
        M.lmbPrev = M.lmb
        M.lmb = UserInputService:IsMouseButtonPressed(Enum.KeyCode.LeftButton)
        if not M.lmb then M.dragSlider = nil; M.dragWin = nil end

        local mkNow = vkDown(M.menuKey)
        if mkNow and not M.menuWas then
            M.visible = not M.visible
            if not M.visible then M.ddOpen = nil; M.kbListen = nil; M.boxFocus = nil; M.dragSlider = nil; M.dragWin = nil end
        end
        M.menuWas = mkNow

        if M.kbListen then
            -- when listening just started, ignore keys already held (e.g. the M1
            -- click that opened the bind) until released, so they aren't captured.
            if M.kbListen ~= M._kbArmed then
                M._kbArmed = M.kbListen
                M._kbIgnore = {}
                for _, kc in ipairs(ALL_KC) do if vkDown(kc) then M._kbIgnore[kc] = true end end
            end
            for _, kc in ipairs(ALL_KC) do
                local down = vkDown(kc)
                if not down then M._kbIgnore[kc] = nil end     -- released -> now bindable
                if down and not M._kbIgnore[kc] then
                    if M.kbListen.bindMenu then
                        M.menuKey = kc; M.menuWas = true       -- don't fire toggle until released
                    else
                        M.kbListen.val = vkToStr(kc); M.kbListen._was = true
                    end
                    M.kbListen, M._kbArmed = nil, nil
                    break
                end
            end
        else
            M._kbArmed = nil
        end

        for _, win in ipairs(M.windows) do
            for _, e in ipairs(win.elems) do
                if e.type == "keybind" and e ~= M.kbListen and not e.bindMenu then
                    local down = vkDown(strToVk(e.val))
                    if down and not e._was then task.spawn(e.cb) end
                    e._was = down
                end
            end
        end
    end)

    -- text box typing
    UserInputService.InputBegan:Connect(function(input)
        if not M.boxFocus then return end
        if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
        local kc, e = input.KeyCode, M.boxFocus
        if kc == Enum.KeyCode.Backspace then
            e.val = e.val:sub(1, -2)
        elseif kc == Enum.KeyCode.Return or kc == Enum.KeyCode.Escape then
            M.boxFocus = nil; task.spawn(e.cb, e.val)
        elseif kc == Enum.KeyCode.Space then
            e.val = e.val .. " "
        else
            local shift = UserInputService:IsKeyDown(Enum.KeyCode.LeftShift)
                       or UserInputService:IsKeyDown(Enum.KeyCode.RightShift)
            local ch = charFor(kc, shift)
            if ch then e.val = e.val .. ch end
        end
    end)

    -- ── draw loop (PreRender) ───────────────────────────────────────────
    RunService.PreRender:Connect(function()
        drawNotifs()
        ensureConfig()
        -- pin the built-in Config window to the far right of all user windows (once)
        if not M.configPlaced and #M.windows > 1 then
            local maxRight, topY
            for _, win in ipairs(M.windows) do
                if not win._config then
                    local r = win.x + win.width
                    if not maxRight or r > maxRight then maxRight = r end
                    if not topY or win.y < topY then topY = win.y end
                end
            end
            if maxRight then M.config.x = maxRight + 16; M.config.y = topY or 24; M.configPlaced = true end
        end
        if not M.visible then return end

        local mx, my = M.mx, M.my
        local click = M.lmb and not M.lmbPrev
        M.pendingDD = nil

        -- region of the currently open dropdown/multi overlay (clicks here are
        -- owned by the overlay, never by the elements/windows behind it).
        M.blockRect = (M.ddOpen and M.ddOpen._ovl) or nil
        local overlayClick = click and M.blockRect
            and pin(mx, my, M.blockRect.x, M.blockRect.y, M.blockRect.w, M.blockRect.h)

        -- measure window bounds for hit-testing this frame
        for _, win in ipairs(M.windows) do
            win._w, win._h = win.width, winHeight(win)
        end

        -- determine the front-most window under the cursor (click owner)
        local clickWin = nil
        if click and not overlayClick then
            for i = #M.windows, 1, -1 do
                local win = M.windows[i]
                if pin(mx, my, win.x, win.y, win._w, win._h) then clickWin = win; break end
            end
            if not clickWin then M.kbListen = nil; M.boxFocus = nil end  -- ddOpen closed by overlay
        end

        -- focus: bring clicked window to front; start drag if title grabbed
        if clickWin then
            if M.windows[#M.windows] ~= clickWin then
                for i, w in ipairs(M.windows) do
                    if w == clickWin then table.remove(M.windows, i); break end
                end
                M.windows[#M.windows + 1] = clickWin
            end
            if pin(mx, my, clickWin.x, clickWin.y, clickWin._w, TITLE_H) then
                -- not the minimize button area
                if not pin(mx, my, clickWin.x + clickWin._w - PAD - 16, clickWin.y, 24, TITLE_H) then
                    M.dragWin = clickWin; M.dragOX = mx - clickWin.x; M.dragOY = my - clickWin.y
                end
            end
        end
        if M.dragWin and M.lmb then M.dragWin.x = mx - M.dragOX; M.dragWin.y = my - M.dragOY end

        -- draw windows back-to-front; only the front-most under cursor gets clicks
        for _, win in ipairs(M.windows) do
            drawWindow(win, (win == clickWin), click)
        end

        -- dropdown overlay always on top, always interactive
        if M.pendingDD then drawDropdown(M.pendingDD, click) end
    end)

    return M
end

